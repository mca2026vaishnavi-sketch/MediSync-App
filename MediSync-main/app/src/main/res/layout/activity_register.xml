<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true" android:background="@drawable/medisync_screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp" android:background="@drawable/medisync_card" android:elevation="9dp" android:translationZ="1dp" android:layout_margin="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♥ MediSync"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#382B4B"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create your account"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#382B4B"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join MediSync to organise your health."
            android:textSize="14sp"
            android:textColor="#887B9B"
            android:layout_marginBottom="28dp" />

        <EditText
            android:id="@+id/etRegisterName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Full name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="#382B4B"
            android:textColorHint="#887B9B"
            android:background="@drawable/medisync_input" />

        <EditText
            android:id="@+id/etRegisterUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="Username"
            android:inputType="text"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="#382B4B"
            android:textColorHint="#887B9B"
            android:background="@drawable/medisync_input" />

        <EditText
            android:id="@+id/etRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="#382B4B"
            android:textColorHint="#887B9B"
            android:background="@drawable/medisync_input" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:hint="Confirm password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="#382B4B"
            android:textColorHint="#887B9B"
            android:background="@drawable/medisync_input" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="Create Account"
            android:textAllCaps="false"
            android:background="@drawable/medisync_button_primary"
            android:textColor="#FFFCFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="Already have an account? Login"
            android:textSize="14sp"
            android:textColor="#B79AE8"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>