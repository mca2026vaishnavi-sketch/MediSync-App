<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/medisync_screen_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MediBot"
        android:textColor="#382B4B"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your MediSync health assistant"
        android:textColor="#887B9B"
        android:textSize="14sp"
        android:paddingStart="8dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnHealthyHabits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Healthy habits"
            android:backgroundTint="#F0E9FA"
            android:textColor="#382B4B" />

        <Button
            android:id="@+id/btnMedicineHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Missed a medicine?"
            android:backgroundTint="#F0E9FA"
            android:textColor="#382B4B" />

        <Button
            android:id="@+id/btnAppointmentHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Doctor appointments"
            android:backgroundTint="#F0E9FA"
            android:textColor="#382B4B" />

        <Button
            android:id="@+id/btnAppHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to use MediSync"
            android:backgroundTint="#F0E9FA"
            android:textColor="#382B4B" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/medisync_input"
            android:hint="Ask MediBot..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:padding="12dp"
            android:imeOptions="actionSend" />
        <Button
            android:id="@+id/btnVoice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:background="@drawable/medisync_button_primary"
            android:textColor="#FFFCFF"
            android:padding="0dp"
            android:text="🎤"
            android:contentDescription="Speak your question" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Send"
            android:background="@drawable/medisync_button_primary"
            android:textColor="#FFFCFF" />

    </LinearLayout>


</LinearLayout>