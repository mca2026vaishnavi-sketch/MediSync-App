<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true" android:background="@drawable/medisync_screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp" android:background="@drawable/medisync_card" android:elevation="9dp" android:translationZ="1dp" android:layout_margin="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medicine Reminder"
            android:textColor="#382B4B"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Choose when you want to take your medicine."
            android:textColor="#887B9B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMedicineInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/medisync_input"
            android:padding="14dp"
            android:text="Saved medicine details will appear here."
            android:textColor="#382B4B"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reminder Date"
            android:textColor="#382B4B"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etReminderDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/medisync_input"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="Select date"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:padding="12dp"
            android:textColor="#382B4B"
            android:textColorHint="#887B9B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reminder Time (24-hour)"
            android:textColor="#382B4B"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etReminderTime"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/medisync_input"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="Select time (e.g. 20:45)"
            android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
            android:padding="12dp"
            android:textColor="#382B4B"
            android:textColorHint="#887B9B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes (Optional)"
            android:textColor="#382B4B"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etReminderDescription"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/medisync_input"
            android:gravity="top"
            android:hint="E.g. Take after dinner"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp"
            android:textColor="#382B4B"
            android:textColorHint="#887B9B" />

        <Button
            android:id="@+id/btnSaveMedicineReminder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/medisync_input"
            android:text="Save Reminder"
            android:textAllCaps="false"
            android:textColor="#382B4B"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
