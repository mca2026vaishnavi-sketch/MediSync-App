<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/medisync_screen_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Greeting and profile, following the user's sketch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MEDISYNC • YOUR HEALTH, IN SYNC"
                        android:textColor="#8A70B8"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Good morning!"
                        android:textColor="@color/medisync_text"
                        android:textSize="28sp"
                        android:fontFamily="sans"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Let's take care of you today."
                        android:textColor="@color/medisync_muted"
                        android:textSize="14sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/profileButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/medisync_avatar"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="♙"
                    android:textColor="#7959B5"
                    android:textSize="27sp"
                    android:contentDescription="Open profile" />
            </LinearLayout>

            <!-- Unified search -->
            <LinearLayout
                android:id="@+id/homeSearchContainer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="23dp"
                android:background="@drawable/medisync_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="⌕"
                    android:textColor="#8975AB"
                    android:textSize="27sp" />
                <EditText
                    android:id="@+id/homeSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search medicines, appointments, records..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="6dp"
                    android:singleLine="true"
                    android:textColor="#382B4B"
                    android:textColorHint="#9B91AD"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Health progress card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/medisync_progress_card" android:elevation="8dp" android:translationZ="1dp"
                android:orientation="vertical"
                android:padding="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YOUR HEALTH JOURNEY"
                            android:textColor="#7966A1"
                            android:textSize="10sp"
                            android:letterSpacing="0.1"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Progress at a glance"
                            android:textColor="#382B4B"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Keep your health records in one place."
                            android:textColor="#776B8B"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/medisync_chart_badge"
                        android:gravity="center"
                        android:text="↗"
                        android:textColor="#7654B4"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="16dp"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp">
                    <View android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_marginEnd="7dp" android:background="@drawable/chart_bar_lilac" />
                    <View android:layout_width="0dp" android:layout_height="39dp" android:layout_weight="1" android:layout_marginEnd="7dp" android:background="@drawable/chart_bar_blue" />
                    <View android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginEnd="7dp" android:background="@drawable/chart_bar_pink" />
                    <View android:layout_width="0dp" android:layout_height="49dp" android:layout_weight="1" android:layout_marginEnd="7dp" android:background="@drawable/chart_bar_lilac" />
                    <View android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="7dp" android:background="@drawable/chart_bar_blue" />
                    <View android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:background="@drawable/chart_bar_pink" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Records" android:textColor="#746785" android:textSize="11sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="View health history  ›" android:textColor="#7654B4" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Calendar date tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your schedule"
                    android:textColor="@color/medisync_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/btnCalendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Open calendar  ›"
                    android:textColor="#8968C4"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:layout_marginEnd="7dp" android:background="@drawable/date_tile_selected" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAT" android:textColor="#FFFCFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="24" android:textColor="#FFFCFF" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textColor="#F1E9FF" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="4dp" android:background="@drawable/date_tile" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TUE" android:textColor="#897C9E" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="25" android:textColor="#382C4E" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tomorrow" android:textColor="#9A8EAD" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/date_tile" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MON" android:textColor="#897C9E" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="26" android:textColor="#382C4E" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plan ahead" android:textColor="#9A8EAD" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:layout_marginStart="7dp" android:background="@drawable/date_tile" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TUE" android:textColor="#897C9E" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="27" android:textColor="#382C4E" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plan ahead" android:textColor="#9A8EAD" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Next actions / reminders -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Coming up" android:textColor="@color/medisync_text" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnRemindersHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="See all  ›" android:textColor="#8968C4" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/medisync_surface_card" android:elevation="8dp" android:translationZ="1dp"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout android:id="@+id/btnReminders" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="5dp">
                    <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/medisync_mint_badge" android:gravity="center" android:text="◷" android:textColor="#7C9FBA" android:textSize="23sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medication reminders" android:textColor="#382B4B" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Stay on track with your schedule" android:textColor="#8C819D" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#9D8ABF" android:textSize="25sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="9dp" android:background="#F0EAF7" />
                <LinearLayout android:id="@+id/btnRecord" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="5dp">
                    <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/medisync_blue_badge" android:gravity="center" android:text="▤" android:textColor="#7C8EDB" android:textSize="22sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medical records" android:textColor="#382B4B" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Reports, scans and consultation notes" android:textColor="#8C819D" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#9D8ABF" android:textSize="25sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Additional tools retained from the original app -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="23dp" android:text="Quick access" android:textColor="@color/medisync_text" android:textSize="19sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:orientation="horizontal">
                <TextView android:id="@+id/btnResolve" android:layout_width="0dp" android:layout_height="94dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/medisync_surface_card" android:elevation="8dp" android:translationZ="1dp" android:clickable="true" android:focusable="true" android:gravity="center" android:padding="10dp" android:text="✦\nHealth guidance\nResolve" android:textColor="#8067B0" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/cardMediBot" android:layout_width="0dp" android:layout_height="94dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/medisync_surface_card" android:elevation="8dp" android:translationZ="1dp" android:clickable="true" android:focusable="true" android:gravity="center" android:padding="10dp" android:text="✧\nMediBot\nHealth assistant" android:textColor="#8067B0" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnEmergency" android:layout_width="0dp" android:layout_height="94dp" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/medisync_surface_card" android:elevation="8dp" android:translationZ="1dp" android:clickable="true" android:focusable="true" android:gravity="center" android:padding="10dp" android:text="✚\nEmergency\nContact" android:textColor="#B77CA5" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Persistent navigation, simplified to match the sketch -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFFCFF"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:weightSum="4">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⌂\nHome" android:textColor="#805DBB" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/navRecords" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="▤\nRecords" android:textColor="#A69AB9" android:textSize="12sp" />
        <TextView android:id="@+id/navReminders" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="♧\nReminders" android:textColor="#A69AB9" android:textSize="12sp" />
        <TextView android:id="@+id/navAccount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="♙\nProfile" android:textColor="#A69AB9" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
