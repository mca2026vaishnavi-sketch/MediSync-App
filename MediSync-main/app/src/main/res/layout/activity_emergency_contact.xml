<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true" android:background="@drawable/medisync_screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp" android:background="@drawable/medisync_card" android:elevation="9dp" android:translationZ="1dp" android:layout_margin="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Contact"
            android:textColor="#382B4B"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Save someone to contact in an emergency."
            android:textColor="#887B9B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etContactName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/medisync_input"
            android:hint="Contact name"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:textColor="#382B4B"
            android:textColorHint="#887B9B" />

        <EditText
            android:id="@+id/etRelationship"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/medisync_input"
            android:hint="Relationship (e.g. Parent, Friend)"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:textColor="#382B4B"
            android:textColorHint="#887B9B" />

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/medisync_input"
            android:hint="10-digit phone number"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="14dp"
            android:textColor="#382B4B"
            android:textColorHint="#887B9B" />

        <Button
            android:id="@+id/btnSaveContact"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/medisync_button_primary"
            android:text="Save Contact"
            android:textAllCaps="false"
            android:textColor="#FFFCFF"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>