<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp" android:background="@drawable/medisync_screen_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Appointments"
        android:textColor="#382B4B"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage your upcoming doctor appointments."
        android:textColor="#887B9B"
        android:textSize="14sp"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/btnAddAppointment"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="+ Add Appointment"
        android:textAllCaps="false"
        android:textColor="#FFFCFF"
        android:background="@drawable/medisync_button_primary"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/tvEmptyAppointments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No appointments added yet."
        android:textColor="#887B9B"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvAppointments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E3D8F2"
        android:dividerHeight="8dp"
        android:background="@drawable/medisync_card" android:elevation="7dp" />

</LinearLayout>